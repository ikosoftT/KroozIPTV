{
  "name": "krooziptv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check:launch": "node scripts/check-launch.mjs",
    "format": "prettier --write app components data lib tests scripts *.ts *.mjs *.json",
    "format:check": "prettier --check app components data lib tests scripts *.ts *.mjs *.json",
    "images:movies": "node scripts/download-movie-posters.mjs",
    "images:brand": "node scripts/create-brand-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
